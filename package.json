{
  "name": "acad",
  "version": "0.1.0",
  "description": "ACAD — Agent Computer-Aided Design for the browser WebOS",
  "scripts": {
    "start": "npm run build:physical-parameters-worker && npm run build:sketch-worker && npm run build:project-worker && npm run build:native-archive-worker && npm run build:manufacturing-hash-worker && npm run build:controlled-3mf-worker && npm run build:prism-workers && node ./node_modules/webpack-dev-server/bin/webpack-dev-server.js --config webpack.config.js --port 3000 --host 0.0.0.0",
    "pack": "npm run build:physical-parameters-worker && npm run build:sketch-worker && npm run build:project-worker && npm run build:native-archive-worker && npm run build:manufacturing-hash-worker && npm run build:controlled-3mf-worker && npm run build:prism-workers && node ./node_modules/webpack/bin/webpack.js --config webpack.config.js --progress --profile --color",
    "start-with-docs": "concurrently --kill-others 'npm start' './node_modules/grunt/bin/grunt docs-start'",
    "build": "npm run build:physical-parameters-worker && npm run build:sketch-worker && npm run build:project-worker && npm run build:native-archive-worker && npm run build:manufacturing-hash-worker && npm run build:controlled-3mf-worker && npm run build:prism-workers && grunt",
    "lint": "./node_modules/eslint/bin/eslint.js web/app modules",
    "lint-fix": "./node_modules/eslint/bin/eslint.js --fix web/app modules",
    "check-code": "./node_modules/typescript/bin/tsc --noEmit",
    "test:polynomial": "node test/coreTests/run-polynomial-powers.cjs",
    "test:sketch-history": "node test/coreTests/run-sketch-history.cjs",
    "test:selection-marker": "node test/coreTests/run-selection-marker.cjs",
    "test:strict-sketch-io": "node test/coreTests/run-strict-sketch-io.cjs",
    "checks-passed-banner": "echo 'All conditions passed. Ready to go to the main branch. Good job!'",
    "before-main-branch-merge": "npm run lint && npm run check-code && npm run checks-passed-banner",
    "cypress": "npx cypress open",
    "build:controlled-3mf-worker": "webpack --config build/webpack.controlled-3mf-worker.cjs",
    "build:manufacturing-hash-worker": "webpack --config build/webpack.manufacturing-hash-worker.cjs && webpack --config build/webpack.manufacturing-publication-worker.cjs",
    "build:physical-parameters-worker": "webpack --config build/webpack.physical-parameters-worker.cjs",
    "build:project-worker": "node build/precompile-numeric.cjs && webpack --config build/webpack.project-validation-worker.cjs",
    "build:sketch-worker": "node build/precompile-numeric.cjs && webpack --config build/webpack.headless-sketch-worker.cjs",
    "build:selected-profile-worker": "node build/prepare-selected-profile-assets.cjs \"${CODI_SELECTED_NATIVE_DIR}\"",
    "build:prism-workers": "npm run build:selected-profile-worker && node build/prepare-prism-assets.cjs && webpack --config build/webpack.prism-semantic-worker.cjs && node build/prepare-raw-smlib-assets.cjs && npm run build:polygon-profile-worker && npm run build:mechanical-profile-worker && npm run build:boolean-history-worker && npm run build:revolve-profile && npm run build:sweep-profile && npm run build:loft-profile && npm run build:adaptive-metrology && npm run build:step-export && npm run build:manufacturing-mesh && npm run build:shell",
    "build:polygon-profile-worker": "node build/prepare-polygon-profile-assets.cjs \"${CODI_POLYGON_NATIVE_DIR}\" && node build/polygon-profile-assets-entry.cjs",
    "build:mechanical-profile-worker": "node build/prepare-mechanical-profile-assets.cjs \"${CODI_MECHANICAL_NATIVE_DIR}\" && node build/mechanical-profile-assets-entry.cjs",
    "build:boolean-history-worker": "node build/prepare-boolean-history-assets.cjs \"${CODI_BOOLEAN_HISTORY_NATIVE_DIR}\" && node build/boolean-history-assets-entry.cjs",
    "build:revolve-profile": "node build/prepare-revolve-assets.cjs",
    "build:sweep-profile": "node build/prepare-sweep-assets.cjs",
    "build:loft-profile": "node build/prepare-loft-assets.cjs",
    "build:adaptive-metrology": "node build/prepare-adaptive-metrology-assets.cjs",
    "build:step-export": "node build/prepare-step-export-assets.cjs",
    "build:manufacturing-mesh": "node build/prepare-manufacturing-mesh-assets.cjs",
    "build:shell": "node build/prepare-shell-assets.cjs",
    "build:native-archive-worker": "webpack --config build/webpack.native-archive-worker.cjs"
  },
  "repository": {
    "type": "git",
    "url": "example.invalid/srv/data/git/ACAD.git"
  },
  "keywords": [
    "parametric",
    "cad"
  ],
  "author": "Val Erastov <xibyte@gmail.com> (http://github.com/xibyte)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xibyte/jsketcher/issues"
  },
  "homepage": "https://github.com/xibyte/jsketcher",
  "devDependencies": {
    "@babel/cli": "^7.18.10",
    "@babel/core": "^7.18.10",
    "@babel/eslint-parser": "^7.18.9",
    "@babel/eslint-plugin": "^7.18.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.18.10",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.18.9",
    "@babel/preset-env": "^7.18.10",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-stage-2": "^7.8.3",
    "@babel/preset-typescript": "^7.18.6",
    "@cypress/webpack-preprocessor": "^5.12.2",
    "@types/react": "^16.9.34",
    "@types/react-dom": "^16.9.7",
    "@typescript-eslint/eslint-plugin": "^5.33.0",
    "@typescript-eslint/parser": "^5.33.0",
    "babel-loader": "^8.2.5",
    "babel-plugin-transform-decorators-legacy": "^1.3.5",
    "babel-polyfill": "^6.26.0",
    "buffer": "^6.0.3",
    "concurrently": "^7.3.0",
    "css-loader": "^3.4.2",
    "cypress": "^4.7.0",
    "cypress-wait-until": "^1.7.1",
    "del": "^6.0.0",
    "eslint": "^8.22.0",
    "eslint-plugin-import": "^2.26.0",
    "file-loader": "^6.2.0",
    "glob": "^8.0.3",
    "grunt": "^1.1.0",
    "grunt-contrib-copy": "1.0.0",
    "grunt-contrib-watch": "^1.1.0",
    "handlebars": "^4.7.7",
    "less-loader": "^11.0.0",
    "less-vars-loader": "^1.1.0",
    "raw-loader": "^4.0.0",
    "style-loader": "^1.1.3",
    "typescript": "^4.7.4",
    "url-loader": "^4.1.1",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.10.0"
  },
  "dependencies": {
    "@dxfjs/parser": "0.2.0",
    "@noble/hashes": "1.8.0",
    "@tarikjabiri/dxf": "2.6.2",
    "@types/three": "^0.143.0",
    "acorn": "8.8.0",
    "browser-xml2js": "^0.4.19",
    "classnames": "2.2.5",
    "clipper-lib": "6.2.1",
    "component-emitter": "1.1.3",
    "earcut": "2.1.1",
    "font-awesome": "4.7.0",
    "immer": "^9.0.12",
    "jsketcher-occ-engine": "1.0.1-5efaf53accb45bac475155fc4d5552642c19e91e",
    "jszip": "^3.10.0",
    "less": "^3.11.1",
    "libtess": "1.2.2",
    "lodash": "^4.17.15",
    "manifold-3d": "^3.4.1",
    "marked": "^4.0.18",
    "mousetrap": "1.6.1",
    "numeric": "1.2.6",
    "prop-types": "^15.8.1",
    "react": "^16.13.1",
    "react-color": "^2.19.3",
    "react-dom": "^16.13.1",
    "react-icons": "^4.4.0",
    "react-toastify": "^5.5.0",
    "sprintf": "0.1.5",
    "three": "^0.143.0",
    "@zip.js/zip.js": "2.24.0"
  }
}
